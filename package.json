{
  "name": "ffmplaiz",
  "version": "1.2.0",
  "description": "ffmplaiz - A simple graphical interface for FFmpeg commands",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "build:mac": "electron-builder --mac",
    "build:mac:dir": "electron-builder --mac --dir"
  },
  "keywords": [
    "ffmpeg",
    "video",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0"
  },
  "build": {
    "appId": "com.ffmplaiz.app",
    "productName": "ffmplaiz",
    "win": {
      "target": "portable",
      "icon": null
    },
    "mac": {
      "target": "dir",
      "category": "public.app-category.video"
    },
    "extraResources": [
      {
        "from": "commands.json",
        "to": "commands.json"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css"
    ]
  }
}
